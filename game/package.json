{
  "name": "de-dust2-fps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 5173",
    "assets:build": "\"${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}\" -b -P tools/build_assets.py --",
    "scene:import": "\"${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}\" -b -P tools/build_blend.py --",
    "scene:export": "\"${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}\" -b scene/pavilion.blend -P tools/export_scene.py --",
    "scene:edit": "\"${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}\" scene/pavilion.blend",
    "sync:watch": "PLAYCANVAS_USE_CWD_AS_TARGET=1 pcsync watch",
    "sync:push": "PLAYCANVAS_USE_CWD_AS_TARGET=1 pcsync push",
    "sync:pull": "PLAYCANVAS_USE_CWD_AS_TARGET=1 pcsync pull",
    "sync:diff": "PLAYCANVAS_USE_CWD_AS_TARGET=1 pcsync diff"
  },
  "devDependencies": {
    "obj2gltf": "^3.2.0",
    "playcanvas": "^2.19.7",
    "playcanvas-sync": "^2.1.1",
    "playwright": "^1.61.0"
  }
}
