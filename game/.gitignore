node_modules/
*.log

# PlayCanvas sync — real config holds your API key; keep it out of git.
pcconfig.json
.pcconfig

# Blender working files. The .blend embeds the imported GLB payload (~10 MB) and
# is fully rebuildable with `npm run scene:import` from scene.manifest.mjs +
# scene.placements.json — those two are the tracked truth. See BLENDER_SCENE.md.
scene/*.blend
scene/*.blend[0-9]

# Blender runs the tools with its bundled Python.
tools/__pycache__/

# Raw source assets and the build cache. Assets are no longer built here — they
# arrive finished from the singularity-developement-kit and are tracked the
# moment they land in assets/. These two lines stay anyway, so a source/ left
# behind by the move, or a stale cache, cannot creep back into a commit.
assets/source/
assets/.assets.cache.json

# macOS AppleDouble sidecars. This drive is exFAT, so copying an asset in
# creates a 4 KB `._name.glb` beside it that is not a model.
._*
